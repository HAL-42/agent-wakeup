#!/bin/sh
set -eu
if ! command -v uv >/dev/null 2>&1; then
    printf '%s\n' 'agent-wakeup requires uv. Install it from https://docs.astral.sh/uv/getting-started/installation/.' >&2
    exit 127
fi
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
exec uv run --locked --project "$project_dir" agent-wakeup "$@"
